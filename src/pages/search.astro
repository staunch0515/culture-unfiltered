---
import BaseLayout from '@/layouts/BaseLayout.astro';

const types = [
  { value: '', label: 'Everything' },
  { value: 'Story', label: 'Stories' },
  { value: 'Person', label: 'People' },
  { value: 'Theme', label: 'Themes' },
  { value: 'Resource', label: 'Resources' },
  { value: 'Page', label: 'Pages' },
];
---
<BaseLayout title="Search" description="Search every story, person, theme and resource in Culture, Unfiltered.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">Find anything</p>
      <h1>Search</h1>
    </header>
    <form class="filter-bar search-form" role="search" action="" method="get" data-search-form>
      <div class="field">
        <label for="search-q" class="label">Search the exhibition</label>
        <div class="field-row">
          <input class="input" id="search-q" name="q" type="search" placeholder="Try “home”, “food” or a name" autocomplete="off" spellcheck="false" />
          <button class="btn btn-primary" type="submit">Search</button>
        </div>
      </div>
      <fieldset class="filter-group">
        <legend class="label">Show</legend>
        {types.map((t, i) => (
          <label class="chip"><input type="radio" name="type" value={t.value} checked={i === 0} /><span>{t.label}</span></label>
        ))}
      </fieldset>
    </form>

    <p class="label" role="status" data-search-status></p>
    <ol class="results" data-search-results></ol>
    <noscript><p>Search needs JavaScript. You can browse <a href="/stories/">stories</a>, <a href="/people/">people</a> and <a href="/themes/">themes</a> instead.</p></noscript>
  </div>
</BaseLayout>

<script>
  import { searchSite } from '@/scripts/pagefind';

  const form = document.querySelector<HTMLFormElement>('[data-search-form]')!;
  const input = form.querySelector<HTMLInputElement>('input[name="q"]')!;
  const status = document.querySelector<HTMLElement>('[data-search-status]')!;
  const list = document.querySelector<HTMLOListElement>('[data-search-results]')!;
  const labels: Record<string, string> = { Story: 'Story', Person: 'Person', Theme: 'Theme', Resource: 'Resource', Page: 'Page' };
  let token = 0;
  let debounce: number | undefined;

  const typeValue = () => form.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value ?? '';

  function render(hits: Awaited<ReturnType<typeof searchSite>>, q: string) {
    list.replaceChildren();
    if (hits === null) {
      status.textContent = 'Search works on the published site. It is not available in this preview.';
      return;
    }
    status.textContent = q ? `${hits.length} ${hits.length === 1 ? 'result' : 'results'} for “${q}”` : '';
    for (const hit of hits) {
      const li = document.createElement('li');
      li.className = 'result';
      // Only stories and people have meaningful thumbnails.
      if (hit.meta.image && (hit.meta.type === 'Story' || hit.meta.type === 'Person')) {
        const img = document.createElement('img');
        img.src = hit.meta.image;
        img.alt = '';
        img.width = 96;
        img.height = 96;
        img.loading = 'lazy';
        img.className = 'result__thumb';
        li.append(img);
      }
      const body = document.createElement('div');
      const type = document.createElement('p');
      type.className = 'label result__type';
      type.textContent = labels[hit.meta.type ?? ''] ?? 'Page';
      const h = document.createElement('h2');
      h.className = 'result__title';
      const a = document.createElement('a');
      a.href = hit.url;
      a.textContent = hit.meta.title ?? hit.url;
      h.append(a);
      const excerpt = document.createElement('p');
      excerpt.className = 'result__excerpt';
      // Excerpts come from this site's own build-time index; they contain only <mark> tags.
      excerpt.innerHTML = hit.excerpt;
      body.append(type, h, excerpt);
      li.append(body);
      list.append(li);
    }
  }

  async function run(updateUrl: boolean) {
    const q = input.value.trim();
    const type = typeValue();
    const mine = ++token;
    if (updateUrl) {
      const url = new URL(location.href);
      url.searchParams.delete('q');
      url.searchParams.delete('type');
      if (q) url.searchParams.set('q', q);
      if (type) url.searchParams.set('type', type);
      history.replaceState(null, '', url);
    }
    if (!q) {
      list.replaceChildren();
      status.textContent = '';
      return;
    }
    const hits = await searchSite(q, type ? { type } : {});
    if (mine === token) render(hits, q);
  }

  const params = new URLSearchParams(location.search);
  input.value = params.get('q') ?? '';
  const initialType = params.get('type');
  if (initialType) {
    const radio = form.querySelector<HTMLInputElement>(`input[name="type"][value="${CSS.escape(initialType)}"]`);
    if (radio) radio.checked = true;
  }
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    window.clearTimeout(debounce);
    void run(true);
  });
  input.addEventListener('input', () => {
    window.clearTimeout(debounce);
    debounce = window.setTimeout(() => void run(true), 200);
  });
  form.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).matches('input[name="type"]')) void run(true);
  });
  void run(false);
</script>

<style>
  .results { list-style: none; padding: 0; margin: 16px 0 0; }
  .results :global(.result) {
    position: relative; display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 20px; align-items: start;
    padding-block: 16px; border-top: 1px solid var(--rule);
  }
  .results :global(.result:has(> div:only-child)) { grid-template-columns: minmax(0, 1fr); }
  .results :global(.result__thumb) { width: 120px; height: auto; aspect-ratio: 1; object-fit: cover; background: var(--paper-2); }
  .results :global(.result__type) { margin-bottom: 6px; }
  .results :global(.result__title) { font-size: 28px; margin-bottom: 6px; }
  .results :global(.result__title a) { text-decoration: none; }
  .results :global(.result__title a::after) { content: ''; position: absolute; inset: 0; }
  .results :global(.result:hover .result__title a) { text-decoration: underline; text-decoration-thickness: 1px; }
  .results :global(.result:focus-within) { outline: 3px solid var(--focus); outline-offset: 6px; }
  .results :global(.result__title a:focus-visible) { outline: none; }
  .results :global(.result__excerpt) { color: var(--muted); font-size: 17px; }
  .results :global(mark) { background: var(--mark); color: var(--on-mark); padding-inline: 0.1em; }
  @media (max-width: 639px) {
    .results :global(.result) { grid-template-columns: 72px minmax(0, 1fr); gap: 14px; }
    .results :global(.result__thumb) { width: 72px; }
  }
</style>
