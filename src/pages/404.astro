---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/lib/url';
---
<BaseLayout title="Page not found">
  <div class="wrap">
    <header class="page-head not-found">
      <p class="label">Error 404</p>
      <h1>This page wandered <em>off</em></h1>
      <p class="intro">We could not find what you were looking for. It may have moved, or it may never have existed.</p>
      <p class="actions">
        <a class="btn btn-primary" href={href('/')}>Back to the start <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href={href('/stories/')}>Browse stories</a>
      </p>
    </header>
  </div>
</BaseLayout>
<style>
  .not-found h1 em { font-style: italic; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
