---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorldMap from '@/components/WorldMap.astro';
import SectionHead from '@/components/SectionHead.astro';
import Frame from '@/components/Frame.astro';
import { loadSite } from '@/lib/content';
import { href } from '@/lib/url';

const s = await loadSite();
const mapData = s.activeCountries.map((country) => ({ country, count: s.peopleIn(country.id).length }));
const panels = s.activeCountries.map((country) => ({
  country,
  people: s.peopleIn(country.id),
  stories: s.stories.filter((st) => st.countries.some((c) => c.id === country.id)).length,
}));
---
<BaseLayout title="Map" description="Where the participants of Culture, Unfiltered live.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">{s.activeCountries.length} countries</p>
      <h1 id="map-title">Where we are</h1>
      <p class="intro">The map is just a way in. Choose a place to meet the people who live there.</p>
    </header>
    <WorldMap countries={mapData} headingId="map-title" />
  </div>

  <section class="section wrap" aria-labelledby="places-heading">
    <SectionHead id="places-heading" title="By place" />
    <ul class="places reveal-stagger">
      {panels.map(({ country, people, stories }) => (
        <li class="place reveal" id={`place-${country.id}`}>
          <h3 class="place__name"><span aria-hidden="true">{country.data.flag} </span>{country.data.name}</h3>
          <ul class="place__people">
            {people.map((p) => (
              <li>
                <a href={href(`/people/${p.id}/`)}>
                  <Frame src={p.data.photo} alt="" ratio="avatar" width={44} fallbackName={p.data.name} />
                  <span>{p.data.name}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="place__links">
            <a class="more-link" href={href(`/people/?country=${country.id}`)}>{people.length} {people.length === 1 ? 'person' : 'people'}</a>
            <a class="more-link" href={href(`/stories/?country=${country.id}`)}>{stories} {stories === 1 ? 'story' : 'stories'}</a>
          </p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .places { list-style: none; padding: 0; margin: 0; display: grid; gap: 40px 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  .place { border-top: 1.5px solid var(--ink); padding-top: 16px; display: grid; gap: 12px; align-content: start; }
  .place__name { font-size: 30px; }
  .place__people { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .place__people a { display: flex; align-items: center; gap: 10px; min-height: var(--tap); text-decoration: none; font: 400 22px/1 var(--display); }
  .place__people a:hover span { text-decoration: underline; }
  .place__people :global(.frame) { width: 44px; }
  .place__links { display: flex; flex-wrap: wrap; gap: 0 20px; }
</style>
