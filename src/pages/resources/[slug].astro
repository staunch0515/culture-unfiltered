---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoryCard from '@/components/StoryCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import Crumbs from '@/components/Crumbs.astro';
import { loadSite, type Resource } from '@/lib/content';
import { resourceKindLabels } from '@/lib/constants';

export async function getStaticPaths() {
  const s = await loadSite();
  return s.resources.map((resource) => ({ params: { slug: resource.id }, props: { resource } }));
}
interface Props { resource: Resource }
const { resource } = Astro.props;
const { Content } = await render(resource.entry);
const d = resource.data;
---
<BaseLayout title={d.title} description={d.description} searchType="Resource">
  <article>
    <div class="wrap">
      <header class="page-head resource-head">
        <Crumbs trail={[{ label: 'Resources', path: '/resources/' }]} />
        <p class="label">{resourceKindLabels[d.kind]}</p>
        <h1>{d.title}</h1>
        <p class="intro">{d.description}</p>
        <dl class="facts" data-pagefind-ignore>
          <dt class="label">Ages</dt><dd>{d.ageGroup}</dd>
          <dt class="label">Time</dt><dd>{d.duration}</dd>
        </dl>
        {d.pdf && <p><a class="btn btn-primary" href={d.pdf} download>Download PDF <span class="arrow" aria-hidden="true">↓</span></a></p>}
      </header>
      <div class="prose resource-body"><Content /></div>
    </div>
    {resource.stories.length > 0 && (
      <section class="section wrap" aria-labelledby="related-heading" data-pagefind-ignore>
        <SectionHead id="related-heading" title="Related stories" />
        <ul class="grid-3 reveal-stagger">{resource.stories.map((story) => <li class="reveal"><StoryCard story={story} /></li>)}</ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .resource-head h1 { font-size: clamp(44px, 7vw, 100px); }
  .resource-body { padding-bottom: 24px; }
</style>
