---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResourceList from '@/components/ResourceList.astro';
import FilterGroup from '@/components/FilterGroup.astro';
import { loadSite } from '@/lib/content';
import { resourceKinds, resourceKindLabels } from '@/lib/constants';
const s = await loadSite();
const kinds = resourceKinds.filter((k) => s.resources.some((r) => r.data.kind === k));
---
<BaseLayout title="Resources" description="Free classroom activities, discussion guides and reflection prompts built around our stories.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">For teachers, clubs and curious people</p>
      <h1>Resources</h1>
      <p class="intro">Free activities that build on stories from this site. Print them, adapt them, make them yours.</p>
    </header>
    {kinds.length > 1 && (
      <form class="filter-bar" data-filter="resources" data-noun="resource" aria-label="Filter resources" hidden>
        <FilterGroup legend="Type" name="kind" dataKey="kind"
          options={kinds.map((k) => ({ value: k, label: resourceKindLabels[k], count: s.resources.filter((r) => r.data.kind === k).length }))} />
        <div class="filter-foot">
          <p class="label" role="status" data-filter-status="resources"></p>
          <button type="reset" class="text-btn">Clear all filters</button>
        </div>
      </form>
    )}
    <ResourceList resources={s.resources} filterGroup="resources" />
  </div>
</BaseLayout>

<script>
  import { initFilters } from '@/scripts/filters';
  initFilters();
</script>
