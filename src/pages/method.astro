---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { principles } from '@/lib/method';
import { href } from '@/lib/url';

const steps = [
  'We pick a theme and agree on one question.',
  'Each participant answers it in their own format: video, writing, photos, an interview or audio.',
  'We meet online, share drafts, and give each other feedback.',
  'Every contributor approves the final version before it is published.',
  'We finish with a reflection: what surprised us, what we assumed, what we learned.',
];
---
<BaseLayout title="Our Method" searchType="Page" description="How we make Culture, Unfiltered: five principles for telling personal stories.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">How we work</p>
      <h1>Our Method</h1>
      <p class="intro">Culture, Unfiltered works like a small anthropology project. We observe everyday life, ask good questions, and <span class="mark">listen more than we explain</span>.</p>
    </header>

    <section class="text-section" aria-labelledby="principles-heading">
      <h2 id="principles-heading">Five principles</h2>
      <ul class="principles reveal-stagger">
        {principles.map((p) => (
          <li class="reveal">
            <h3 class="accent-bar">{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="text-section prose" aria-labelledby="process-heading">
      <h2 id="process-heading">How a story gets made</h2>
      <ol>{steps.map((step) => <li>{step}</li>)}</ol>
      <p><a class="btn btn-primary" href={href('/resources/')}>Use our method in class <span class="arrow" aria-hidden="true">→</span></a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .text-section { padding-top: clamp(40px, 6vw, 72px); }
  .text-section > h2 { font-size: clamp(34px, 5vw, 56px); margin-bottom: 32px; }
  .prose.text-section > h2 { margin-bottom: 0; }
  .principles { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 32px 24px; }
  .principles h3 { font-size: 28px; margin-bottom: 10px; }
  .principles p { color: var(--muted); font-size: 17px; }
</style>
