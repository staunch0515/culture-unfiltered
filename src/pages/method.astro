---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import { principles } from '@/lib/method';
import { href } from '@/lib/url';

const steps = [
  'We pick a theme and agree on one question.',
  'Each participant answers it in their own format: video, writing, photos, an interview or audio.',
  'We meet online, share drafts, and give each other feedback.',
  'Every contributor approves the final version before it is published.',
  'We finish with a reflection: what surprised us, what we assumed, what we learned.',
];
---
<BaseLayout title="Our Method" description="How we make Culture, Unfiltered: five principles for telling personal stories.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">How we work</p>
      <h1>Our Method</h1>
      <p class="lede">Culture, Unfiltered works like a small anthropology project. We observe everyday life, ask good questions, and listen more than we explain.</p>
    </header>

    <section class="section" aria-labelledby="principles-heading">
      <SectionHead index={1} id="principles-heading" title="Five principles" />
      <ol class="principles reveal-stagger">
        {principles.map((p, i) => (
          <li class="reveal">
            <span class="principles__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="process-heading">
      <SectionHead index={2} id="process-heading" title="How a story gets made" />
      <ol class="steps">
        {steps.map((step) => <li class="reveal">{step}</li>)}
      </ol>
      <p><a class="button" href={href('/resources/')}>Use our method in class <span class="arrow" aria-hidden="true">→</span></a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .principles { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-5) var(--space-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .principles li { border-top: 2px solid var(--ink); padding-top: var(--space-3); }
  .principles__n { display: block; font-family: var(--font-display); font-weight: 800; font-stretch: 118%; font-size: var(--step-5); line-height: 1; color: var(--accent); margin-bottom: var(--space-3); }
  .principles h3 { font-size: var(--step-2); }
  .principles p { font-family: var(--font-serif); font-size: var(--step-1); color: var(--ink-soft); margin: 0; }
  .steps { counter-reset: step; list-style: none; padding: 0; margin: 0 0 var(--space-5); max-width: 48rem; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 3rem 1fr; gap: var(--space-3); padding: var(--space-4) 0; border-top: 1px solid var(--line); font-family: var(--font-serif); font-size: var(--step-1); }
  .steps li::before { content: counter(step); font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); color: var(--accent); line-height: 1.1; }
</style>
