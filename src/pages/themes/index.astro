---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ThemeList from '@/components/ThemeList.astro';
import { loadSite } from '@/lib/content';
const s = await loadSite();
const themeData = s.themes.map((theme) => ({ theme, count: s.storiesAbout(theme.id).length }));
---
<BaseLayout title="Themes" description="The everyday themes we explore: one question, many answers.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">{s.themes.length} shared questions</p>
      <h1>Themes</h1>
      <p class="lede">One question per theme, answered by people in different places and placed side by side.</p>
    </header>
    <ThemeList themes={themeData} headingLevel="h2" />
  </div>
</BaseLayout>
