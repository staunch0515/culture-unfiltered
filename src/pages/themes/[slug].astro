---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoryCard from '@/components/StoryCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import Frame from '@/components/Frame.astro';
import Crumbs from '@/components/Crumbs.astro';
import { loadSite, type Theme } from '@/lib/content';
import { href } from '@/lib/url';

export async function getStaticPaths() {
  const s = await loadSite();
  return s.themes.map((theme) => ({ params: { slug: theme.id }, props: { theme } }));
}
interface Props { theme: Theme }
const { theme } = Astro.props;
const s = await loadSite();
const groups = s.contributionsByCountry(theme.id);
const stories = s.storiesAbout(theme.id);
---
<BaseLayout title={theme.data.title} description={theme.data.question} searchType="Theme">
  <div class="wrap">
    <header class="page-head theme-head">
      <Crumbs trail={[{ label: 'Themes', path: '/themes/' }]} />
      <p class="label"><span aria-hidden="true">{theme.data.emoji}</span> Theme</p>
      <h1>{theme.data.title}</h1>
      <p class="theme-head__question">{theme.data.question}</p>
      <p class="intro">{theme.data.description}</p>
    </header>
  </div>

  <section class="section wrap" aria-labelledby="compare-heading">
    <SectionHead id="compare-heading" title="Side by side" eyebrow={`${groups.length} ${groups.length === 1 ? 'country' : 'countries'}`} />
    {groups.length === 0 ? (
      <p class="intro">No stories on this theme yet.</p>
    ) : (
      <div class="compare reveal-stagger">
        {groups.map(({ country, items }) => (
          <section class="compare__group reveal" aria-labelledby={`c-${country.id}`}>
            <h3 id={`c-${country.id}`} class="compare__country"><span aria-hidden="true">{country.data.flag} </span>{country.data.name}</h3>
            <ul class="compare__quotes">
              {items.map(({ person, story, perspective }) => (
                <li class="quote-card">
                  <div class="quote-card__who">
                    <Frame src={person.data.photo} alt="" ratio="avatar" width={52} fallbackName={person.data.name} />
                    <div>
                      <p class="quote-card__name"><a href={href(`/people/${person.id}/`)}>{person.data.name}</a></p>
                      <p class="label">{person.data.location}</p>
                    </div>
                  </div>
                  {perspective?.text && <p class="quote-card__text quote-card__text--quote">“{perspective.text}”</p>}
                  <a class="more-link" href={href(`/stories/${story.id}/`)}>From “{story.data.title}” <span class="arrow" aria-hidden="true">→</span></a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )}
  </section>

  {stories.length > 0 && (
    <section class="section wrap" aria-labelledby="stories-heading" data-pagefind-ignore>
      <SectionHead id="stories-heading" title={`Stories about ${theme.data.title.toLowerCase()}`} />
      <ul class="grid-3 reveal-stagger">{stories.map((story) => <li class="reveal"><StoryCard story={story} /></li>)}</ul>
    </section>
  )}
</BaseLayout>

<style>
  .theme-head__question { font: italic 400 clamp(26px, 3vw, 38px)/1.3 var(--display); max-width: 30ch; }
  /* Countries side by side; each column stacks that country's voices. */
  .compare { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 48px 28px; align-items: start; }
  .compare__group { display: grid; gap: 16px; align-content: start; }
  .compare__country { font-size: clamp(30px, 3.4vw, 40px); }
  .compare__quotes { list-style: none; padding: 0; margin: 0; display: grid; gap: 32px; }
  .quote-card__text--quote { font: italic 400 22px/1.35 var(--display); -webkit-line-clamp: 8; }
</style>
