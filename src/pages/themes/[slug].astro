---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoryCard from '@/components/StoryCard.astro';
import { loadSite, type Theme } from '@/lib/content';
import { href } from '@/lib/url';

export async function getStaticPaths() {
  const s = await loadSite();
  return s.themes.map((theme) => ({ params: { slug: theme.id }, props: { theme } }));
}
interface Props { theme: Theme }
const { theme } = Astro.props;
const s = await loadSite();
const groups = s.contributionsByCountry(theme.id);
const stories = s.storiesAbout(theme.id);
---
<BaseLayout title={theme.data.title} description={theme.data.question}>
  <div class="wrap">
    <header class="theme-head">
      <p class="eyebrow"><span aria-hidden="true">{theme.data.emoji}</span> Theme</p>
      <h1>{theme.data.title}</h1>
      <p class="question">{theme.data.question}</p>
      <p class="lede">{theme.data.description}</p>
    </header>

    <section aria-labelledby="compare-heading">
      <h2 id="compare-heading">Side by side</h2>
      {groups.length === 0 ? (
        <p class="muted">No stories on this theme yet.</p>
      ) : (
        <ul class="compare">
          {groups.map(({ country, items }) => (
            <li class="compare__col">
              <h3><span aria-hidden="true">{country.data.flag}</span> {country.data.name}</h3>
              <ul class="compare__items">
                {items.map(({ person, story, perspective }) => (
                  <li class="compare__item">
                    <div class="compare__who">
                      <Image src={person.data.photo} alt="" width={48} height={48} class="compare__avatar" />
                      <a href={href(`/people/${person.id}/`)}>{person.data.name}</a>
                    </div>
                    {perspective?.text && <blockquote><p>{perspective.text}</p></blockquote>}
                    <p class="muted small">From <a href={href(`/stories/${story.id}/`)}>{story.data.title}</a></p>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      )}
    </section>

    {stories.length > 0 && (
      <section aria-labelledby="stories-heading">
        <h2 id="stories-heading">Stories about {theme.data.title.toLowerCase()}</h2>
        <ul class="grid">{stories.map((story) => <li><StoryCard story={story} /></li>)}</ul>
      </section>
    )}

    <p><a href={href('/themes/')}>All themes</a></p>
  </div>
</BaseLayout>

<style>
  .theme-head { padding-block: var(--space-5) 0; }
  .question { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2rem); margin: 0 0 var(--space-3); }
  .compare { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .compare__col { border-top: 3px solid var(--color-text); padding-top: var(--space-3); }
  .compare__items { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); }
  .compare__who { display: flex; align-items: center; gap: var(--space-2); font-weight: 600; }
  .compare__avatar { width: 2.5rem; height: 2.5rem; border-radius: 50%; }
  blockquote { margin: var(--space-2) 0; font-family: var(--font-display); font-size: 1.1rem; }
  blockquote p { margin: 0; }
  .small { font-size: 0.875rem; margin: 0; }
</style>
