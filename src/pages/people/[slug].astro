---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoryCard from '@/components/StoryCard.astro';
import CountryLabel from '@/components/CountryLabel.astro';
import SectionHead from '@/components/SectionHead.astro';
import { loadSite, type Person } from '@/lib/content';
import { href } from '@/lib/url';

export async function getStaticPaths() {
  const s = await loadSite();
  return s.people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}
interface Props { person: Person }
const { person } = Astro.props;
const s = await loadSite();
const stories = s.storiesBy(person.id);
const themes = s.themesOf(person.id);
const d = person.data;
const thumb = await getImage({ src: d.photo, width: 160, height: 160 });
let n = 0;
const next = () => ++n;
---
<BaseLayout title={d.name} description={d.bio} searchType="Person" searchImage={thumb.src}>
  <article>
    <header class="wrap profile">
      <div class="profile__photo">
        <Image src={d.photo} alt={d.photoAlt} width={640} height={640} loading="eager" fetchpriority="high" />
      </div>
      <div class="profile__text">
        <p class="eyebrow"><CountryLabel country={person.country} /> · {d.location}</p>
        <h1 class="profile__name">{d.name}</h1>
        <p class="lede">{d.bio}</p>
        <dl class="facts">
          <div><dt>Interests</dt><dd><ul class="tags">{d.interests.map((i) => <li class="tag">{i}</li>)}</ul></dd></div>
          {d.languages.length > 0 && (
            <div><dt>Languages</dt><dd><ul class="tags">{d.languages.map((l) => <li class="tag">{l}</li>)}</ul></dd></div>
          )}
          {themes.length > 0 && (
            <div><dt>Themes</dt><dd><ul class="tags">{themes.map((t) => <li><a class="tag" href={href(`/themes/${t.id}/`)}><span aria-hidden="true">{t.data.emoji}</span>{t.data.title}</a></li>)}</ul></dd></div>
          )}
        </dl>
      </div>
    </header>

    <section class="section on-night perspective-band" aria-labelledby="perspective-heading">
      <div class="wrap">
        <SectionHead index={next()} id="perspective-heading" title="My Perspective" />
        <blockquote class="big-quote"><p>{d.perspective}</p></blockquote>
      </div>
    </section>

    {stories.length > 0 && (
      <section class="wrap section" aria-labelledby="stories-heading">
        <SectionHead index={next()} id="stories-heading" title={`Stories with ${d.name}`} />
        <ul class="grid reveal-stagger">{stories.map((story) => <li class="reveal"><StoryCard story={story} /></li>)}</ul>
      </section>
    )}

    {d.reflection && (
      <section class="wrap section" aria-labelledby="reflection-heading">
        <SectionHead index={next()} id="reflection-heading" title="Reflection" />
        <p class="editorial">{d.reflection}</p>
      </section>
    )}

    <p class="wrap"><a class="text-link" href={href('/people/')}><span aria-hidden="true">←</span> All people</a></p>
  </article>
</BaseLayout>

<style>
  .profile { display: grid; gap: var(--space-5); padding-block: var(--space-6) var(--space-6); align-items: center; }
  .profile__photo { max-width: 22rem; }
  .profile__photo img { width: 100%; aspect-ratio: 1; border-radius: 50%; background: var(--paper-2); }
  .profile__name { font-size: var(--step-6); line-height: 0.9; margin-bottom: var(--space-4); }
  @media (min-width: 52rem) { .profile { grid-template-columns: minmax(14rem, 26rem) 1fr; gap: var(--space-7); } .profile__photo { max-width: none; } }
  .facts { display: grid; gap: var(--space-3); margin: 0; }
  .facts dt { font-size: var(--step--2); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: var(--space-2); }
  .facts dd { margin: 0; }
  .perspective-band { margin-bottom: var(--space-3); }
  .big-quote { margin: 0; max-width: 30ch; font-family: var(--font-serif); font-size: var(--step-4); line-height: 1.2; }
  .big-quote::before { content: '“'; display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.6em; line-height: 0.5; color: var(--night-accent); margin-bottom: var(--space-3); }
  .big-quote p { margin: 0; }
</style>
