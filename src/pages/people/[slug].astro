---
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoryCard from '@/components/StoryCard.astro';
import Frame from '@/components/Frame.astro';
import CountryLabel from '@/components/CountryLabel.astro';
import Crumbs from '@/components/Crumbs.astro';
import { loadSite, type Person } from '@/lib/content';
import { href } from '@/lib/url';

export async function getStaticPaths() {
  const s = await loadSite();
  return s.people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}
interface Props { person: Person }
const { person } = Astro.props;
const s = await loadSite();
const stories = s.storiesBy(person.id);
const themes = s.themesOf(person.id);
const d = person.data;
const thumb = await getImage({ src: d.photo, width: 160, height: 160 });
---
<BaseLayout title={d.name} description={d.bio} searchType="Person" searchImage={thumb.src}>
  <article>
    <header class="wrap person-head">
      <div class="person-head__photo">
        <Frame src={d.photo} alt={d.photoAlt} ratio="portrait" width={420} sizes="(max-width: 759px) 320px, 400px" eager fallbackName={d.name} />
      </div>
      <div class="person-head__text">
        <Crumbs trail={[{ label: 'People', path: '/people/' }]} />
        <p class="label"><CountryLabel country={person.country} flag location={d.location} /></p>
        <h1 class="person-head__name">{d.name}</h1>
        <p class="person-head__bio">{d.bio}</p>
      </div>
    </header>

    <section class="wrap person-section rule-top" aria-labelledby="perspective-heading">
      <h2 id="perspective-heading">My Perspective</h2>
      <blockquote class="person-quote"><p>{d.perspective}</p></blockquote>
    </section>

    <section class="wrap person-section rule-top" aria-labelledby="about-heading">
      <h2 id="about-heading">About {d.name}</h2>
      <dl class="facts">
        <dt class="label">From</dt><dd><CountryLabel country={person.country} location={d.location} /></dd>
        <dt class="label">Interests</dt><dd><ul class="tags">{d.interests.map((i) => <li class="tag">{i}</li>)}</ul></dd>
        {d.languages.length > 0 && <><dt class="label">Languages</dt><dd><ul class="tags">{d.languages.map((l) => <li class="tag">{l}</li>)}</ul></dd></>}
        {themes.length > 0 && <><dt class="label">Themes</dt><dd><ul class="tags">{themes.map((t) => <li><a class="tag" href={href(`/themes/${t.id}/`)}><span aria-hidden="true">{t.data.emoji}</span>{t.data.title}</a></li>)}</ul></dd></>}
      </dl>
    </section>

    {stories.length > 0 && (
      <section class="wrap person-section rule-top" aria-labelledby="stories-heading">
        <h2 id="stories-heading">Stories with {d.name}</h2>
        <ul class="grid-2 reveal-stagger">{stories.map((story) => <li class="reveal"><StoryCard story={story} /></li>)}</ul>
      </section>
    )}

    {d.reflection && (
      <section class="wrap person-section rule-top" aria-labelledby="reflection-heading">
        <h2 id="reflection-heading">Reflection</h2>
        <p class="person-reflection">{d.reflection}</p>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .person-head {
    display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); align-items: end;
    gap: clamp(24px, 4vw, 56px); padding-block: clamp(32px, 5vw, 64px) clamp(40px, 6vw, 72px);
  }
  .person-head__text { display: grid; gap: 18px; }
  .person-head__name { font-size: clamp(56px, 9vw, 128px); line-height: 0.95; }
  .person-head__bio { font-size: 20px; max-width: 52ch; }
  @media (max-width: 759px) {
    .person-head { grid-template-columns: minmax(0, 1fr); }
    .person-head__photo { max-width: 320px; }
  }

  .person-section {
    display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px clamp(24px, 4vw, 56px);
    padding-block: clamp(40px, 6vw, 72px);
  }
  .person-section h2 { font-size: clamp(30px, 4vw, 44px); }
  @media (max-width: 759px) { .person-section { grid-template-columns: minmax(0, 1fr); } }
  .person-quote { font: italic 400 clamp(26px, 3vw, 38px)/1.3 var(--display); max-width: 30ch; }
  .person-reflection { font-size: 20px; max-width: 56ch; }
  .grid-2 { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 24px; }
  @media (max-width: 639px) { .grid-2 { grid-template-columns: minmax(0, 1fr); } }
</style>
