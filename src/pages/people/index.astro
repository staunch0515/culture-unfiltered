---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PersonCard from '@/components/PersonCard.astro';
import FilterGroup from '@/components/FilterGroup.astro';
import { loadSite } from '@/lib/content';

const s = await loadSite();
---
<BaseLayout title="People" description="Meet the young people behind Culture, Unfiltered.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">{s.people.length} voices · {s.activeCountries.length} countries</p>
      <h1>People</h1>
      <p class="intro">Everyone here speaks for themselves, not for their country. Meet the people behind the stories.</p>
    </header>

    <form class="filter-bar" data-filter="people" data-noun="person" data-nouns="people" aria-label="Filter people" hidden>
      <FilterGroup legend="Country" name="country" dataKey="country"
        options={s.activeCountries.map((c) => ({ value: c.id, label: c.data.name, flag: c.data.flag, count: s.peopleIn(c.id).length }))} />
      <div class="filter-foot">
        <p class="label" role="status" data-filter-status="people"></p>
        <button type="reset" class="text-btn">Clear all filters</button>
      </div>
    </form>

    <ul class="grid-4 reveal-stagger">
      {s.people.map((p) => (
        <li class="reveal" data-filter-item="people" data-country={p.country.id}><PersonCard person={p} headingLevel="h2" /></li>
      ))}
    </ul>
    <p class="empty" data-filter-empty="people" hidden>Nobody matches these filters yet.</p>
  </div>
</BaseLayout>

<style>
  .empty { padding-block: 48px; font: italic 400 28px/1.3 var(--display); color: var(--muted); }
</style>

<script>
  import { initFilters } from '@/scripts/filters';
  initFilters();
</script>
