---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoryCard from '@/components/StoryCard.astro';
import FilterGroup from '@/components/FilterGroup.astro';
import { loadSite } from '@/lib/content';
import { mediaTypes, mediaLabels } from '@/lib/constants';
import { href } from '@/lib/url';

const s = await loadSite();
const countBy = (pred: (st: (typeof s.stories)[number]) => boolean) => s.stories.filter(pred).length;
const countries = s.countries.filter((c) => s.stories.some((st) => st.countries.some((x) => x.id === c.id)));
const themes = s.themes.filter((t) => s.storiesAbout(t.id).length > 0);
const media = mediaTypes.filter((m) => s.stories.some((st) => st.data.mediaType === m));
---
<BaseLayout title="Stories" description="Videos, articles, photo essays, interviews and audio, made by young people.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">{s.stories.length} stories · {media.length} formats</p>
      <h1>Stories</h1>
      <p class="intro">Videos, articles, photo essays, interviews and audio. Search, or filter by country, theme or format.</p>
    </header>

    <form class="filter-bar" data-filter="stories" data-noun="story" data-nouns="stories" role="search" aria-label="Filter stories" hidden>
      <div class="field">
        <label class="label" for="story-q">Search stories</label>
        <input class="input" id="story-q" type="search" name="q" data-search="Story" placeholder="Words, names, places…" autocomplete="off" />
      </div>
      <FilterGroup legend="Country" name="country" dataKey="countries"
        options={countries.map((c) => ({ value: c.id, label: c.data.name, flag: c.data.flag, count: countBy((st) => st.countries.some((x) => x.id === c.id)) }))} />
      <FilterGroup legend="Theme" name="theme" dataKey="themes"
        options={themes.map((t) => ({ value: t.id, label: t.data.title, count: countBy((st) => st.themes.some((x) => x.id === t.id)) }))} />
      <FilterGroup legend="Format" name="media" dataKey="media"
        options={media.map((m) => ({ value: m, label: mediaLabels[m], count: countBy((st) => st.data.mediaType === m) }))} />
      <div class="filter-foot">
        <p class="label" role="status" data-filter-status="stories"></p>
        <button type="reset" class="text-btn">Clear all filters</button>
      </div>
    </form>

    <ul class="grid-3 reveal-stagger">
      {s.stories.map((story) => (
        <li class="reveal" data-filter-item="stories" data-url={href(`/stories/${story.id}/`)}
          data-countries={story.countries.map((c) => c.id).join(' ')} data-themes={story.themes.map((t) => t.id).join(' ')} data-media={story.data.mediaType}>
          <StoryCard story={story} headingLevel="h2" />
        </li>
      ))}
    </ul>
    <p class="empty" data-filter-empty="stories" hidden>No stories match these filters yet. Try clearing one.</p>
  </div>
</BaseLayout>

<style>
  .empty { padding-block: 48px; font: italic 400 28px/1.3 var(--display); color: var(--muted); }
</style>

<script>
  import { initFilters } from '@/scripts/filters';
  initFilters();
</script>
