---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import VideoEmbed from '@/components/VideoEmbed.astro';
import Frame from '@/components/Frame.astro';
import CountryLabel from '@/components/CountryLabel.astro';
import ResourceList from '@/components/ResourceList.astro';
import StoryCard from '@/components/StoryCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import Crumbs from '@/components/Crumbs.astro';
import { loadSite, type Story } from '@/lib/content';
import { mediaLabels } from '@/lib/constants';
import { href, formatDate, listJoin } from '@/lib/url';

export async function getStaticPaths() {
  const s = await loadSite();
  return s.stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}
interface Props { story: Story }
const { story } = Astro.props;
const s = await loadSite();
const { Content } = await render(story.entry);
const d = story.data;
const resources = s.resourcesFor(story.id);
const related = s.relatedTo(story.id);
const thumb = await getImage({ src: d.thumbnail, width: 240 });
const words = (story.entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
---
<BaseLayout title={d.title} description={d.description} searchType="Story" searchImage={thumb.src}>
  <article>
    <header class="wrap story-head">
      <Crumbs trail={[{ label: 'Stories', path: '/stories/' }]} />
      <h1 class="story-head__title">{d.title}</h1>
      <p class="story-head__summary">{d.description}</p>
      <p class="story-head__meta">
        <span class="label">{mediaLabels[d.mediaType]}</span>
        <span class="label"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></span>
        <span class="label">{minutes} min read</span>
        <span class="story-head__by">By {story.contributors.map((p, i) => (
          <>{i > 0 && (i === story.contributors.length - 1 ? ' and ' : ', ')}<a class="person-link" href={href(`/people/${p.id}/`)}>{p.data.name}</a></>
        ))}</span>
      </p>
    </header>

    <div class="wrap grid-12 story-body">
      <div class="story-body__media">
        {d.video ? (
          <VideoEmbed provider={d.video.provider} id={d.video.id} captions={d.video.captions} title={d.title} poster={d.thumbnail} eager />
        ) : (
          <Frame src={d.thumbnail} alt={d.thumbnailAlt} width={1240} sizes="(max-width: 1288px) 100vw, 1240px" eager />
        )}
      </div>

      {d.audio && (
        <figure class="story-body__col audio">
          <figcaption class="label">Listen</figcaption>
          <audio controls preload="none" src={d.audio.src}></audio>
          {d.audio.transcript && (
            <details class="disclosure"><summary>Read the transcript</summary><p>{d.audio.transcript}</p></details>
          )}
        </figure>
      )}

      <div class="story-body__col prose"><Content /></div>

      <section class="story-body__col" aria-labelledby="about-heading">
        <h2 id="about-heading" class="story-body__h2">About this story</h2>
        <dl class="facts">
          <dt class="label">Made by</dt><dd>{story.contributors.map((p, i) => <>{i > 0 && ', '}<a class="person-link" href={href(`/people/${p.id}/`)}>{p.data.name}</a></>)}</dd>
          <dt class="label">From</dt><dd>{listJoin(story.countries.map((c) => c.data.name))}</dd>
          <dt class="label">Format</dt><dd>{mediaLabels[d.mediaType]}{d.video?.captions && ', with captions'}</dd>
          <dt class="label">Published</dt><dd>{formatDate(d.date)}</dd>
          <dt class="label">Themes</dt><dd><ul class="tags">{story.themes.map((t) => <li><a class="tag" href={href(`/themes/${t.id}/`)}><span aria-hidden="true">{t.data.emoji}</span>{t.data.title}</a></li>)}</ul></dd>
        </dl>
      </section>

      {d.photos.length > 0 && (
        <section class="story-body__wide" aria-labelledby="photos-heading">
          <h2 id="photos-heading" class="story-body__h2">Photos</h2>
          <ul class="photos reveal-stagger">
            {d.photos.map((photo) => (
              <li class="reveal">
                <figure>
                  <Frame src={photo.src} alt={photo.alt} width={800} sizes="(max-width: 859px) 100vw, 620px" />
                  {photo.caption && <figcaption class="label">{photo.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )}

      {story.perspectives.length > 0 && (
        <section class="story-body__wide" aria-labelledby="perspectives-heading">
          <h2 id="perspectives-heading" class="story-body__h2">Perspectives</h2>
          <ul class="quote-grid reveal-stagger">
            {story.perspectives.map((p) => (
              <li class="quote-card reveal">
                <div class="quote-card__who">
                  <Frame src={p.person.data.photo} alt="" ratio="avatar" width={52} fallbackName={p.person.data.name} />
                  <div>
                    <p class="quote-card__name"><a href={href(`/people/${p.person.id}/`)}>{p.person.data.name}</a></p>
                    <p class="label"><CountryLabel country={p.person.country} /></p>
                  </div>
                </div>
                {p.text && <p class="quote-card__text">{p.text}</p>}
                {p.video && <VideoEmbed provider={p.video.provider} id={p.video.id} title={`${p.person.data.name}'s perspective`} compact />}
                <a class="more-link" href={href(`/people/${p.person.id}/`)}>More from {p.person.data.name} <span class="arrow" aria-hidden="true">→</span></a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    {d.reflection && (
      <section class="inverted reflection" aria-labelledby="reflection-heading">
        <div class="wrap">
          <p class="label">Reflection</p>
          <h2 id="reflection-heading">What we took away</h2>
          <ul class="inverted-cols reveal-stagger">
            <li class="reveal"><h3 class="accent-bar">What surprised us?</h3><p>{d.reflection.surprised}</p></li>
            <li class="reveal"><h3 class="accent-bar">What did we assume?</h3><p>{d.reflection.assumed}</p></li>
            <li class="reveal"><h3 class="accent-bar">What did we learn?</h3><p>{d.reflection.learned}</p></li>
          </ul>
        </div>
      </section>
    )}

    {resources.length > 0 && (
      <section class="section wrap" aria-labelledby="resources-heading" data-pagefind-ignore>
        <SectionHead id="resources-heading" title="Use this story in class" />
        <ResourceList resources={resources} headingLevel="h3" />
      </section>
    )}

    {related.length > 0 && (
      <section class="section wrap" aria-labelledby="related-heading" data-pagefind-ignore>
        <SectionHead id="related-heading" title="Keep exploring" link={{ href: href('/stories/'), label: 'All stories' }} />
        <ul class="grid-3 reveal-stagger">{related.map((r) => <li class="reveal"><StoryCard story={r} /></li>)}</ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .story-head { padding-block: clamp(32px, 5vw, 64px) 40px; display: grid; gap: 20px; }
  .story-head__title { font-size: clamp(44px, 7vw, 100px); max-width: 16ch; }
  .story-head__summary { font-size: 22px; max-width: 52ch; }
  .story-head__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
  .story-head__by { font-size: 17px; }

  .story-body { gap: 56px 24px; }
  .story-body > .story-body__col { grid-column: 3 / 11; }
  .story-body > .story-body__media, .story-body > .story-body__wide { grid-column: 1 / -1; }
  @media (max-width: 859px) { .story-body > .story-body__col { grid-column: 1 / -1; } }
  .story-body__h2 { font-size: clamp(34px, 5vw, 56px); margin-bottom: 24px; }
  .prose { font-size: 19px; }

  .audio { display: grid; gap: 10px; }
  .audio audio { width: 100%; }

  .photos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .photos li:first-child { grid-column: 1 / -1; }
  .photos figure { display: grid; gap: 8px; }
  @media (max-width: 639px) { .photos { grid-template-columns: minmax(0, 1fr); } }

  .reflection { margin-top: clamp(48px, 8vw, 104px); }
</style>
