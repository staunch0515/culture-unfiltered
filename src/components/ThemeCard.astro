---
import type { Theme } from '@/lib/content';
import { href } from '@/lib/url';
interface Props { theme: Theme; storyCount: number; headingLevel?: 'h2' | 'h3' }
const { theme, storyCount, headingLevel: H = 'h3' } = Astro.props;
---
<article class="card theme-card">
  <div class="card__body">
    <p class="theme-card__emoji" aria-hidden="true">{theme.data.emoji}</p>
    <H><a class="card__link" href={href(`/themes/${theme.id}/`)}>{theme.data.title}</a></H>
    <p>{theme.data.question}</p>
    <p class="muted">{storyCount} {storyCount === 1 ? 'story' : 'stories'}</p>
  </div>
</article>
<style>
  .theme-card__emoji { font-size: 2rem; line-height: 1; }
</style>
