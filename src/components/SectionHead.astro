---
interface Props {
  id: string;
  title: string;
  /** Small label above the heading (optional). */
  eyebrow?: string;
  link?: { href: string; label: string };
}
const { id, title, eyebrow, link } = Astro.props;
---
<div class="section-head">
  <div class="section-head__titles">
    {eyebrow && <p class="label">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
  </div>
  {link && <a class="btn" href={link.href}>{link.label} <span class="arrow" aria-hidden="true">→</span></a>}
</div>
<style>
  .section-head__titles { display: grid; gap: 10px; }
</style>
