---
import Frame from './Frame.astro';
import type { Story } from '@/lib/content';
import { mediaLabels } from '@/lib/constants';
import { href, formatDate, listJoin } from '@/lib/url';

interface Props {
  story: Story;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { story, headingLevel: H = 'h3', eager = false } = Astro.props;
const d = story.data;
---
<article class="card story-card">
  <Frame src={d.thumbnail} alt={d.thumbnailAlt} width={480} sizes="(max-width: 859px) 100vw, 400px" eager={eager} />
  <p class="label">{mediaLabels[d.mediaType]} · <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></p>
  <H class="card__title"><a href={href(`/stories/${story.id}/`)}>{d.title}</a></H>
  <p class="card__summary">{d.description}</p>
  <p class="label">By {listJoin(story.contributors.map((p) => p.data.name))}</p>
</article>
