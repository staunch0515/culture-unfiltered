---
/**
 * Lightweight SVG map: no tiles, no third-party requests. Every marker comes
 * from country data (lat/lng), so a new country file adds a new marker.
 * Stage 1 draws a graticule only; Stage 3 adds coastlines.
 */
import type { Country } from '@/lib/content';
import { href } from '@/lib/url';

interface Props {
  countries: { country: Country; count: number }[];
  headingId?: string;
}
const { countries, headingId } = Astro.props;
const W = 1000, H = 500;
// Equirectangular projection.
const project = (lat: number, lng: number) => ({ x: ((lng + 180) / 360) * W, y: ((90 - lat) / 180) * H });
const lats = [-60, -30, 0, 30, 60];
const lngs = [-120, -60, 0, 60, 120];
---
<figure class="world-map">
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-labelledby={headingId}>
    <rect width={W} height={H} rx="24" class="world-map__sea" />
    {lats.map((lat) => <line x1="0" x2={W} y1={project(lat, 0).y} y2={project(lat, 0).y} class="world-map__grid" />)}
    {lngs.map((lng) => <line y1="0" y2={H} x1={project(0, lng).x} x2={project(0, lng).x} class="world-map__grid" />)}
    {countries.map(({ country, count }) => {
      const { x, y } = project(country.data.lat, country.data.lng);
      return (
        <a href={href(`/people/?country=${country.id}`)} class="world-map__marker" data-country={country.id}>
          <title>{`${country.data.name}: ${count} ${count === 1 ? 'participant' : 'participants'}`}</title>
          <circle cx={x} cy={y} r="14" />
          <text x={x} y={y - 22} text-anchor="middle">{country.data.name}</text>
        </a>
      );
    })}
  </svg>
  <figcaption class="visually-hidden">Map of participant countries. Each marker links to the people from that country.</figcaption>
</figure>
<ul class="world-map__list">
  {countries.map(({ country, count }) => (
    <li><a href={href(`/people/?country=${country.id}`)}><span aria-hidden="true">{country.data.flag}</span> {country.data.name} <span class="world-map__count">{count}<span class="visually-hidden"> {count === 1 ? 'participant' : 'participants'}</span></span></a></li>
  ))}
</ul>

<style>
  .world-map { margin: 0; }
  .world-map svg { width: 100%; height: auto; }
  .world-map__sea { fill: var(--paper-2); }
  .world-map__grid { stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 6; }
  .world-map__marker circle { fill: var(--accent); stroke: var(--paper); stroke-width: 4; transition: r var(--dur-2) var(--ease-out), fill var(--dur-1); }
  .world-map__marker text { font: 700 20px var(--font-ui); fill: var(--ink); paint-order: stroke; stroke: var(--paper-2); stroke-width: 6px; stroke-linejoin: round; }
  .world-map__marker:hover circle, .world-map__marker:focus-visible circle { fill: var(--ink); r: 18; }
  .world-map__marker:focus-visible { outline: none; }
  .world-map__marker:focus-visible circle { stroke: var(--focus); stroke-width: 4; }
  .world-map__list { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin: var(--space-4) 0 0; }
  .world-map__list a {
    display: inline-flex; align-items: center; gap: 0.4em; min-height: 44px; padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-strong); border-radius: var(--radius-pill); background: var(--surface);
    color: var(--ink); text-decoration: none; font-weight: 600;
    transition: background-color var(--dur-1), color var(--dur-1);
  }
  .world-map__list a:hover { background: var(--ink); color: var(--paper); }
  .world-map__count { color: var(--muted); font-weight: 500; }
  .world-map__list a:hover .world-map__count { color: inherit; }
</style>
