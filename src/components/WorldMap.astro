---
/**
 * Lightweight SVG map: static base maps (/world-map-light.svg, /world-map-dark.svg,
 * built from Natural Earth data at build time) plus inline
 * markers. No tiles, no third-party requests. Every marker comes from country
 * data, so a new country file adds a marker and highlights its outline.
 */
import type { Country } from '@/lib/content';
import { project, MAP_W as W, MAP_H as H } from '@/lib/geo';
import { href } from '@/lib/url';

interface Props {
  countries: { country: Country; count: number }[];
  headingId?: string;
}
const { countries, headingId } = Astro.props;
const markers = countries.map(({ country, count }) => ({ country, count, ...project(country.data.lat, country.data.lng) }));
---
<figure class="world-map">
  <div class="world-map__stage" style={`aspect-ratio: ${W} / ${H}`}>
  <img class="world-map__base world-map__base--light" src={href('/world-map-light.svg')} alt="" width={W} height={H} loading="lazy" decoding="async" />
  <img class="world-map__base world-map__base--dark" src={href('/world-map-dark.svg')} alt="" width={W} height={H} loading="lazy" decoding="async" />
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-labelledby={headingId}>
    {markers.map(({ country, count, x, y }) => (
      <a href={href(`/people/?country=${country.id}`)} class="world-map__marker" data-country={country.id}>
        <title>{`${country.data.name}: ${count} ${count === 1 ? 'participant' : 'participants'}`}</title>
        <circle cx={x} cy={y} r="34" class="world-map__hit" />
        <circle cx={x} cy={y} r="16" class="world-map__pulse" />
        <circle cx={x} cy={y} r="8" class="world-map__dot" />
        <text x={x + 14} y={y + 5} aria-hidden="true">{country.data.name}</text>
      </a>
    ))}
  </svg>
  </div>
  <figcaption class="visually-hidden">Map of participant countries. Each marker links to the people from that country.</figcaption>
</figure>
<ul class="tags world-map__list">
  {countries.map(({ country, count }) => (
    <li><a class="tag" href={href(`/people/?country=${country.id}`)}><span aria-hidden="true">{country.data.flag}</span> {country.data.name} <span class="label">{count}<span class="visually-hidden"> {count === 1 ? 'participant' : 'participants'}</span></span></a></li>
  ))}
</ul>

<style>
  .world-map { margin: 0; container-type: inline-size; }
  .world-map__stage { position: relative; background: var(--paper-2); }
  .world-map__base { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .world-map svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; overflow: visible; }
  /* Show the base map that matches the page scheme (hidden lazy images are never fetched). */
  .world-map__base--dark { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .world-map__base--light { display: none; }
    :global(:root:not([data-theme='light'])) .world-map__base--dark { display: block; }
  }
  :global(:root[data-theme='dark']) .world-map__base--light { display: none; }
  :global(:root[data-theme='dark']) .world-map__base--dark { display: block; }
  .world-map__hit { fill: transparent; }
  .world-map__dot { fill: var(--ink); stroke: var(--paper); stroke-width: 3; transition: r var(--motion) ease-out; }
  .world-map__pulse { fill: var(--mark); opacity: 0.55; transform-box: fill-box; transform-origin: center; }
  .world-map__marker text { font: 500 15px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; fill: var(--ink); paint-order: stroke; stroke: var(--paper-2); stroke-width: 5px; stroke-linejoin: round; pointer-events: none; }
  .world-map__marker:hover .world-map__dot, .world-map__marker:focus-visible .world-map__dot { r: 11; }
  .world-map__marker:focus-visible { outline: none; }
  .world-map__marker:focus-visible .world-map__hit { stroke: var(--focus); stroke-width: 4; }
  @media (prefers-reduced-motion: no-preference) {
    .world-map__pulse { animation: map-pulse 2.8s ease-out infinite; }
  }
  @keyframes map-pulse { 0% { transform: scale(0.6); opacity: 0.7; } 100% { transform: scale(1.9); opacity: 0; } }
  /* Small maps: labels would collide, so the list below carries the names. */
  @container (max-width: 40rem) {
    .world-map__marker text { display: none; }
    .world-map__dot { r: 13; }
    .world-map__hit { r: 66; } /* about 44px on a phone-sized map */
  }
  .world-map__list { margin-top: 20px; }
  .world-map__list .label { margin-left: 2px; }
</style>
