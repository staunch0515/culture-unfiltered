---
import Wordmark from './Wordmark.astro';
import { site } from '@/lib/site';
import { href } from '@/lib/url';

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (path: string) => {
  const target = href(path);
  return target === href('/') ? current === target : current.startsWith(target);
};
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href={href('/')}><Wordmark /></a>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="icon-btn search-link" href={href('/search/')} aria-current={isCurrent('/search/') ? 'page' : undefined}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m20 20-4.8-4.8" stroke-linecap="square" /></svg>
      <span class="visually-hidden">Search</span>
    </a>
    <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__icon" aria-hidden="true"><span></span></span>
      <span class="visually-hidden">Menu</span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const header = document.querySelector<HTMLElement>('.site-header');
  if (toggle && nav && header) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-locked', open);
      if (open) {
        // The panel starts right under the header, wherever the header currently is.
        header.style.setProperty('--panel-top', `${Math.round(header.getBoundingClientRect().bottom)}px`);
        nav.querySelector<HTMLAnchorElement>('a')?.focus();
      } else if (returnFocus) {
        toggle.focus();
      }
    };
    toggle.addEventListener('click', () => setOpen(!isOpen()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false, true);
    });
    nav.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a') && isOpen()) setOpen(false);
    });
    matchMedia('(min-width: 1060px)').addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: var(--paper); border-bottom: 1px solid var(--rule);
  }
  .site-header__inner { display: flex; align-items: center; gap: 16px; min-height: 64px; }
  .site-header__brand { text-decoration: none; color: var(--ink); display: inline-flex; align-items: center; min-height: var(--tap); margin-right: auto; }

  .site-nav ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .site-nav a {
    display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 10px;
    font: 500 13px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; color: var(--ink);
    background-image: linear-gradient(var(--mark), var(--mark));
    background-repeat: no-repeat; background-position: 0 100%; background-size: 0 3px;
    transition: background-size var(--motion) ease-out;
  }
  .site-nav a:hover { text-decoration: underline; }
  .site-nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--mark); }
  .site-nav a:hover:not([aria-current='page']) { background-size: 100% 3px; text-decoration: none; }
  .site-nav a:lang(zh), .site-nav a:lang(ja) { font: 500 15px/1 var(--body); letter-spacing: 0; }

  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: var(--tap); height: var(--tap); padding: 0;
    background: none; border: 0; color: var(--ink); cursor: pointer;
  }
  .search-link[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--mark); }

  .menu-toggle { display: none; }
  .menu-toggle__icon { position: relative; width: 24px; height: 16px; }
  .menu-toggle__icon::before, .menu-toggle__icon::after, .menu-toggle__icon span {
    content: ''; position: absolute; left: 0; width: 100%; height: 2px; background: currentColor;
    transition: transform var(--motion) ease-out, opacity var(--motion) ease-out;
  }
  .menu-toggle__icon::before { top: 0; }
  .menu-toggle__icon span { top: 7px; }
  .menu-toggle__icon::after { bottom: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon::before { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon::after { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1059px) {
    :global(.js) .menu-toggle { display: inline-flex; }
    :global(.js) .site-nav { display: none; }
    :global(.js) .site-nav.is-open {
      display: block; position: fixed; inset: var(--panel-top, 65px) 0 0; z-index: 19;
      background: var(--paper); overflow-y: auto; padding: 8px var(--gutter) 40px;
      animation: panel-in var(--motion) ease-out;
    }
    .site-nav ul { flex-direction: column; }
    .site-nav a {
      display: flex; min-height: 60px; padding: 0; border-bottom: 1px solid var(--rule);
      font: 400 32px/1.1 var(--display); letter-spacing: 0; text-transform: none;
    }
    .site-nav a[aria-current='page'] { box-shadow: none; font-style: italic; }
    .site-nav a[aria-current='page']::before { content: ''; width: 6px; height: 1em; background: var(--mark); margin-right: 12px; }
    .site-nav a:hover:not([aria-current='page']) { background-size: 0 3px; text-decoration: underline; }
    /* Without JS the links stay visible as a wrapped row under the header. */
    :global(html:not(.js)) .site-header__inner { flex-wrap: wrap; }
    :global(html:not(.js)) .site-nav { flex-basis: 100%; order: 3; }
  }
  :global(.menu-locked) { overflow: hidden; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(-6px); } }
  @media (max-width: 380px) { .site-header__inner { gap: 4px; } }
</style>
