---
/** Exhibition-index style list of themes: number, title, question. */
import type { Theme } from '@/lib/content';
import { href } from '@/lib/url';
interface Props {
  themes: { theme: Theme; count: number }[];
  headingLevel?: 'h2' | 'h3';
}
const { themes, headingLevel: H = 'h3' } = Astro.props;
---
<ol class="theme-list">
  {themes.map(({ theme, count }, i) => (
    <li class="theme-row reveal">
      <span class="theme-row__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <span class="theme-row__emoji" aria-hidden="true">{theme.data.emoji}</span>
      <div class="theme-row__text">
        <H class="theme-row__title"><a href={href(`/themes/${theme.id}/`)}>{theme.data.title}</a></H>
        <p class="theme-row__question">{theme.data.question}</p>
      </div>
      <span class="theme-row__count">{count} {count === 1 ? 'story' : 'stories'}</span>
      <span class="theme-row__arrow" aria-hidden="true">→</span>
    </li>
  ))}
</ol>

<style>
  .theme-list { list-style: none; padding: 0; margin: 0; border-bottom: 1px solid var(--ink); }
  .theme-row {
    position: relative; display: grid; align-items: center;
    grid-template-columns: 2.25rem 2.25rem 1fr; gap: var(--space-1) var(--space-3);
    padding: var(--space-4) 0; border-top: 1px solid var(--ink);
    transition: background-color var(--dur-2) var(--ease-out);
  }
  .theme-row__index { font-size: var(--step--1); font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; align-self: start; padding-top: 0.5em; }
  .theme-row__emoji { font-size: 1.5rem; align-self: start; padding-top: 0.15em; }
  .theme-row__title { font-size: var(--step-4); line-height: 1; margin: 0 0 var(--space-2); transition: transform var(--dur-2) var(--ease-out), color var(--dur-1); }
  .theme-row__title a { color: inherit; text-decoration: none; }
  .theme-row__title a::after { content: ''; position: absolute; inset: 0; }
  .theme-row__title a:focus-visible { outline: none; }
  .theme-row:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }
  .theme-row__question { font-family: var(--font-serif); font-size: var(--step-1); color: var(--ink-soft); margin: 0; }
  .theme-row__count { grid-column: 3; font-size: var(--step--1); color: var(--muted); font-weight: 600; }
  .theme-row__arrow { display: none; }
  .theme-row:hover .theme-row__title { color: var(--accent); transform: translateX(6px); }

  @media (min-width: 52rem) {
    .theme-row { grid-template-columns: 3rem 3rem 1fr auto 2rem; }
    .theme-row__count { grid-column: auto; }
    .theme-row__arrow { display: block; font-size: var(--step-3); transition: transform var(--dur-2) var(--ease-out); }
    .theme-row:hover .theme-row__arrow { transform: translateX(6px); color: var(--accent); }
  }
</style>
