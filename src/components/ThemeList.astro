---
/** Ruled topic list: icon, title, question, count. */
import type { Theme } from '@/lib/content';
import { href } from '@/lib/url';
interface Props {
  themes: { theme: Theme; count: number }[];
  headingLevel?: 'h2' | 'h3';
}
const { themes, headingLevel: H = 'h3' } = Astro.props;
---
<ul class="topic-list">
  {themes.map(({ theme, count }) => (
    <li class="reveal">
      <a class="topic-row" href={href(`/themes/${theme.id}/`)}>
        <span class="topic-row__icon" aria-hidden="true">{theme.data.emoji}</span>
        <H class="topic-row__title">{theme.data.title}</H>
        <span class="topic-row__text">{theme.data.question}</span>
        <span class="label">{count} {count === 1 ? 'story' : 'stories'}</span>
      </a>
    </li>
  ))}
</ul>
