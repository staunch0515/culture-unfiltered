---
/**
 * Click-to-load video. Before the click the page makes zero third-party
 * requests: the poster is a local image, and the iframe (youtube-nocookie or
 * Vimeo with dnt=1) is only created when the viewer presses play.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  provider: 'youtube' | 'vimeo';
  id: string;
  title: string;
  captions?: boolean;
  poster?: ImageMetadata;
  compact?: boolean;
  /** Load the poster eagerly (use for the main, above-the-fold video). */
  eager?: boolean;
}
const { provider, id, title, captions = false, poster, compact = false, eager = false } = Astro.props;
const src =
  provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0${captions ? '&cc_load_policy=1' : ''}`
    : `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1`;
const providerName = provider === 'youtube' ? 'YouTube' : 'Vimeo';
---
<figure class:list={['video', { 'video--compact': compact }]}>
  <div class="video__frame" data-video-src={src} data-video-title={title}>
    <button type="button" class="video__play">
      {poster && <Image src={poster} alt="" width={1600} class="video__poster" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />}
      <span class="video__disc" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
      <span class="visually-hidden">Play video: {title}</span>
      <span class="video__notice">The {providerName} player loads only when you press play{captions ? ' · Captions available' : ''}</span>
    </button>
  </div>
</figure>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('.video__play');
    const frame = button?.closest<HTMLElement>('[data-video-src]');
    if (!button || !frame) return;
    const iframe = document.createElement('iframe');
    iframe.src = frame.dataset.videoSrc ?? '';
    iframe.title = frame.dataset.videoTitle ?? 'Video';
    iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    frame.replaceChildren(iframe);
    iframe.focus();
  });
</script>

<style>
  .video { margin: 0; }
  .video__frame { position: relative; aspect-ratio: 16 / 9; background: var(--poster); overflow: hidden; }
  .video__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video__play { all: unset; position: absolute; inset: 0; cursor: pointer; display: grid; place-items: center; color: var(--on-poster); }
  .video__play:focus-visible { outline: 3px solid var(--focus); outline-offset: -6px; }
  .video__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms ease-out; }
  .video__play:hover .video__poster { transform: scale(1.03); }
  .video__disc {
    position: relative; display: grid; place-items: center; width: 88px; height: 88px; border-radius: 50%;
    background: var(--mark); color: var(--on-mark); padding-left: 4px;
    box-shadow: 0 0 0 6px rgb(23 24 26 / 0.35);
  }
  .video__notice {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 8px 12px;
    background: rgb(0 0 0 / 0.72); color: var(--on-poster);
    font: 500 12px/1.4 var(--mono); letter-spacing: 0.06em; text-transform: uppercase;
  }
  .video--compact .video__disc { width: 64px; height: 64px; }
  .video--compact .video__disc svg { width: 22px; height: 22px; }
  @media (max-width: 519px) {
    .video__disc { width: 64px; height: 64px; }
    .video__disc svg { width: 22px; height: 22px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .video__disc { transition: transform var(--motion) ease-out; animation: disc-pulse 2.4s ease-out 3; }
    .video__play:hover .video__disc { transform: scale(1.06); }
  }
  @keyframes disc-pulse {
    0% { box-shadow: 0 0 0 6px rgb(23 24 26 / 0.35), 0 0 0 6px rgb(217 242 74 / 0.5); }
    100% { box-shadow: 0 0 0 6px rgb(23 24 26 / 0.35), 0 0 0 26px rgb(217 242 74 / 0); }
  }
</style>
