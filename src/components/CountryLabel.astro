---
import type { Country } from '@/lib/content';
interface Props {
  country: Country;
  /** A text-size flag emoji before the name (decorative; the name is always given in text). */
  flag?: boolean;
  location?: string | undefined;
}
const { country, flag = false, location } = Astro.props;
---
<span class="country">{flag && <span aria-hidden="true">{country.data.flag} </span>}{country.data.name}{location && ` · ${location}`}</span>
