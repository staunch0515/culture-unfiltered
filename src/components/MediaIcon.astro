---
import type { MediaType } from '@/lib/constants';
interface Props { type: MediaType; size?: number }
const { type, size = 16 } = Astro.props;
---
<svg class="media-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {type === 'video' && <><rect x="2" y="5" width="15" height="14" rx="2" /><path d="m17 10 5-3v10l-5-3" /></>}
  {type === 'article' && <><path d="M5 3h10l4 4v14H5z" /><path d="M9 9h6M9 13h6M9 17h4" /></>}
  {type === 'photo' && <><rect x="3" y="5" width="18" height="15" rx="2" /><circle cx="12" cy="12.5" r="3.5" /><path d="M8 5l1.5-2h5L16 5" /></>}
  {type === 'interview' && <><path d="M4 5h11v8H8l-4 3z" /><path d="M15 9h5v8l-3-2h-6v-2" /></>}
  {type === 'audio' && <><path d="M4 14v-2a8 8 0 0 1 16 0v2" /><rect x="3" y="14" width="4" height="6" rx="1" /><rect x="17" y="14" width="4" height="6" rx="1" /></>}
</svg>
