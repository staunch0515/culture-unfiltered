---
import Wordmark from './Wordmark.astro';
import { site } from '@/lib/site';
import { href } from '@/lib/url';
const links = [...site.nav.filter((n) => n.path !== '/'), { label: 'Map', path: '/map/' }, { label: 'Search', path: '/search/' }];
---
<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__about">
      <a class="site-footer__brand" href={href('/')}><Wordmark /></a>
      <p>{site.tagline}</p>
      <div class="theme-switch" role="group" aria-label="Colour scheme">
        <button type="button" data-theme-choice="auto" aria-pressed="true">Auto</button>
        <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
        <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
      </div>
      <p class="site-footer__privacy">Made by young people. Participants appear by first name only; we never publish schools or addresses. No tracking, no third-party fonts.</p>
    </div>
    <nav aria-label="Footer">
      <ul class="site-footer__links">
        {links.map((n) => <li><a href={href(n.path)}>{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer { border-top: 1.5px solid var(--ink); padding-block: 40px 56px; margin-top: clamp(48px, 8vw, 104px); }
  .site-footer__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px 48px; }
  .site-footer__about { display: grid; gap: 10px; align-content: start; }
  .site-footer__brand { text-decoration: none; color: var(--ink); display: inline-flex; min-height: var(--tap); align-items: center; }
  .site-footer__privacy { color: var(--muted); font-size: 16px; max-width: 44ch; }
  /* Segmented control. Hidden without JS, where the system scheme always applies. */
  .theme-switch { display: none; width: max-content; border: 1.5px solid var(--ink); margin-block: 6px; }
  :global(.js) .theme-switch { display: inline-flex; }
  .theme-switch button {
    min-height: var(--tap); padding: 0 16px; border: 0; background: transparent; color: var(--ink); cursor: pointer;
    font: 500 13px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase;
    transition: background-color var(--motion) ease-out, color var(--motion) ease-out;
  }
  .theme-switch button + button { border-left: 1.5px solid var(--ink); }
  .theme-switch button:hover { text-decoration: underline; }
  .theme-switch button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .site-footer__links { list-style: none; padding: 0; margin: 0; display: grid; }
  .site-footer__links a { display: inline-flex; align-items: center; min-height: var(--tap); min-width: var(--tap); }
</style>
