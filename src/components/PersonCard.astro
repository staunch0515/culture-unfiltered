---
import Frame from './Frame.astro';
import CountryLabel from './CountryLabel.astro';
import type { Person } from '@/lib/content';
import { href } from '@/lib/url';
interface Props { person: Person; headingLevel?: 'h2' | 'h3'; showBio?: boolean }
const { person, headingLevel: H = 'h3', showBio = true } = Astro.props;
---
<article class="card person-card" data-country={person.country.id}>
  <Frame src={person.data.photo} alt={person.data.photoAlt} ratio="portrait" width={320} sizes="(max-width: 639px) 50vw, 300px" fallbackName={person.data.name} />
  <p class="label"><CountryLabel country={person.country} flag /></p>
  <H class="card__title"><a href={href(`/people/${person.id}/`)}>{person.data.name}</a></H>
  {showBio && <p class="card__summary person-card__bio">{person.data.bio}</p>}
  <p class="more-link" aria-hidden="true">View profile <span class="arrow">→</span></p>
</article>
<style>
  .person-card__bio { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .person-card .more-link { min-height: auto; }
</style>
