---
import '@/styles/global.css';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import bodyLatin from '@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2?url';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { site } from '@/lib/site';

export type SearchType = 'Story' | 'Person' | 'Theme' | 'Resource' | 'Page';

interface Props {
  title?: string;
  description?: string;
  /**
   * Pagefind: the result type for this page. Pages without one (home, listings,
   * search, 404) are left out of the index so results never duplicate.
   */
  searchType?: SearchType | undefined;
  /** Pagefind: thumbnail URL shown next to this page in search results. */
  searchImage?: string | undefined;
}
const { title, description = site.description, searchType, searchImage } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f2f1ec" data-dynamic />
    <meta name="color-scheme" content="light dark" />
    {searchType && <meta data-pagefind-filter="type[content]" content={searchType} />}
    {searchType && <meta data-pagefind-meta="type[content]" content={searchType} />}
    {searchType && searchImage && <meta data-pagefind-meta="image[content]" content={searchImage} />}
    <script is:inline>
      document.documentElement.classList.add('js');
      // Apply the visitor's saved colour scheme before first paint (no flash).
      try {
        var t = localStorage.getItem('cu-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {site.showSampleNotice && (
      <p class="sample-notice label"><span class="sample-notice__bar" aria-hidden="true"></span>Preview: all people and stories are placeholders</p>
    )}
    <SiteHeader />
    <main id="main" tabindex="-1" data-pagefind-body={searchType ? '' : undefined}>
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initReveal } from '@/scripts/reveal';
      import { initThemeControls } from '@/scripts/theme';
      initReveal();
      initThemeControls();
    </script>
  </body>
</html>

<style>
  .sample-notice {
    display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
    margin: 0; padding: 8px var(--gutter); text-align: center; color: var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .sample-notice__bar { flex: none; width: 24px; height: 6px; background: var(--mark); }
  main { display: block; min-height: 100vh; }
  main:focus { outline: none; }
</style>
